# systemd unit for one incremental batch of the full-Italy rebuild
# (scripts/build_italy_map_comuni_cron.sh, comune granularity - supersedes
# the old per-provincia scripts/build_italy_map_cron.sh: network centrality
# in compute-lts scales with graph size and was impractically slow on
# provincia-sized graphs). Triggered by ltsbikeplan-rebuild.timer - not
# enabled/started directly.
#
# Install:
#   sudo cp deploy/ltsbikeplan-rebuild.service deploy/ltsbikeplan-rebuild.timer /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now ltsbikeplan-rebuild.timer
#
# Adjust User/WorkingDirectory below if DEPLOY_ROOT passed to
# scripts/setup_server.sh wasn't /opt/stressinbici, or if the repo should
# run as a dedicated service account rather than root.
#
# Logs: journalctl -u ltsbikeplan-rebuild.service

[Unit]
Description=LTSBikePlan full-Italy tile rebuild (incremental comuni batch)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/stressinbici/LTSBikePlan
ExecStart=/opt/stressinbici/LTSBikePlan/scripts/build_italy_map_comuni_cron.sh
# tippecanoe/pmtiles live in /usr/local/bin; the script itself activates
# the repo's own .venv for the Python side.
Environment=PATH=/usr/local/bin:/usr/bin:/bin
# LTSBP_COMUNI_PARALLEL_JOBS (default 4, see the script itself) processes
# that many comuni concurrently - per-comune work is mostly network I/O
# (osmit-estratti extract, Mapterhorn DEM tiles), so this isn't just an
# N-core speedup. Tune down if it starts getting rate-limited/erroring, up
# if the box has cores/bandwidth to spare and batches finish comfortably
# under TimeoutStartSec.
#Environment=LTSBP_COMUNI_PARALLEL_JOBS=4
#
# LTSBP_COMUNI_BATCH_SIZE (default 150, see the script itself) caps how
# many comuni one run processes. IMPORTANT: the merged national tileset
# (the thing the live map actually serves) is only rebuilt once the whole
# batch loop returns - if a batch gets killed by TimeoutStartSec mid-loop,
# individual comuni already done ARE saved (progress.tsv is written
# per-comune), but that run's map-visible rebuild never happens. Measured
# production pace was ~13min/comune serially (150 comuni would take ~33h,
# far past this unit's 3h timeout) - size BATCH_SIZE so
# (BATCH_SIZE / PARALLEL_JOBS) * (observed per-comune time) reliably fits
# well inside TimeoutStartSec, then raise it once you've confirmed batches
# are finishing with room to spare.
#Environment=LTSBP_COMUNI_BATCH_SIZE=150
TimeoutStartSec=3h
